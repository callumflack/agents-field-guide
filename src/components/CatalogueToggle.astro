<template data-catalogue-toggle-template>
  <p class="catalogue-toggle">
    <button
      type="button"
      class="prose-link cursor-pointer text-muted-foreground"
      aria-expanded="false"
    >Show more</button>
    <a class="prose-link text-muted-foreground" hidden>View all <span aria-hidden="true">&rarr;</span></a>
  </p>
</template>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  mount("[data-catalogue-toggle-template]", (template) => {
    const cleanups: Array<() => void> = [];
    if (template instanceof HTMLTemplateElement) {
      const lists = template.parentElement?.querySelectorAll<HTMLUListElement>(":scope > h2 + ul");

      for (const list of lists ?? []) {
        const overflow = Array.from(list.querySelectorAll<HTMLLIElement>(":scope > li")).slice(6);
        if (!overflow.length) continue;

        const heading = list.previousElementSibling;
        const category = heading?.querySelector<HTMLAnchorElement>(":scope > a[href]:not(.heading-anchor)");
        if (!heading || !category) continue;

        const control = template.content.cloneNode(true) as DocumentFragment;
        const button = control.querySelector("button")!;
        const viewAll = control.querySelector("a")!;
        const row = button.parentElement!;
        list.id = `${heading.id}-entries`;
        button.setAttribute("aria-controls", list.id);
        viewAll.href = category.href;

        function revealMore() {
          for (const item of overflow) item.hidden = false;
          button.hidden = true;
          viewAll.hidden = false;
          (overflow[0].querySelector("a") ?? viewAll).focus();
        }

        for (const item of overflow) item.hidden = true;
        button.addEventListener("click", revealMore, { once: true });
        list.after(control);

        cleanups.push(() => {
          button.removeEventListener("click", revealMore);
          for (const item of overflow) item.hidden = false;
          list.removeAttribute("id");
          row.remove();
        });
      }
    }
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  /* Match the Markdown list's 1.25rem inset and its item's 0.25rem inset. */
  :global(.docs-content > .catalogue-toggle) {
    margin-top: 0.5rem;
    padding-inline-start: 1.5rem;
  }
</style>
